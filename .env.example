# Copie este archivo como .env para desarrollo local. Nunca suba .env a GitHub.

# Puerto local
PORT=3000

# Conexión a PostgreSQL. Si se deja vacío en desarrollo, se usa una base de datos en memoria.
DATABASE_URL=

# Secreto para firmar las sesiones. En producción Render lo genera solo (mínimo 32 caracteres).
JWT_SECRET=

# Dirección pública del sitio. En Render se toma de RENDER_EXTERNAL_URL si se deja vacío.
APP_ORIGIN=http://localhost:3000

# La cuenta que se registre con este correo será administradora.
ADMIN_EMAIL=
